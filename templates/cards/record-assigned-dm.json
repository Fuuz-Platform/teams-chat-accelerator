{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "contentUrl": null,
      "content": {
        "type": "AdaptiveCard",
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "version": "1.4",
        "fallbackText": "<ACTOR_NAME> assigned you: <RECORD_TITLE>",
        "body": [
          {
            "type": "ColumnSet",
            "columns": [
              {
                "type": "Column",
                "width": "auto",
                "verticalContentAlignment": "Center",
                "items": [
                  {
                    "type": "Image",
                    "url": "https://fuuz-news.b-cdn.net/brand/email/fuuz-logo-horizontal-on-midnight-320w.png",
                    "width": "84px",
                    "altText": "Fuuz"
                  }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "verticalContentAlignment": "Center",
                "items": [
                  {
                    "type": "TextBlock",
                    "text": "Fuuz - Assigned to you",
                    "horizontalAlignment": "Right",
                    "size": "Small",
                    "isSubtle": true,
                    "wrap": true,
                    "color": "Default"
                  }
                ]
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "<ACTOR_NAME> assigned you: <RECORD_TITLE>",
            "size": "Medium",
            "weight": "Bolder",
            "wrap": true,
            "spacing": "Medium"
          },
          {
            "type": "TextBlock",
            "text": "<RECORD_TYPE> <RECORD_CODE>",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Small"
          },
          {
            "type": "FactSet",
            "spacing": "Medium",
            "facts": [
              {
                "title": "Due",
                "value": "<DATE>"
              },
              {
                "title": "Priority",
                "value": "High"
              },
              {
                "title": "Status",
                "value": "Open"
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "You get this because the record is assigned to you. Change this in your notification preferences.",
            "size": "Small",
            "isSubtle": true,
            "wrap": true,
            "spacing": "Medium"
          }
        ],
        "actions": [
          {
            "type": "Action.OpenUrl",
            "title": "Open record",
            "url": "https://<FUUZ_HOST>/<APP>/<ROUTE>?id=<RECORD_ID>&tenant=<TENANT>",
            "style": "positive"
          }
        ]
      }
    }
  ],
  "fuuz": {
    "target": "dm",
    "recipient": "<UPN>",
    "teamName": null,
    "teamDescription": null,
    "channelName": null,
    "eventKey": "recordAssigned:<MODEL>:<RECORD_ID>:user:<USER_ID>",
    "redacted": false
  }
}
